# Hardhat deployer key (root). Never commit a real value.
PRIVATE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Generate separate high-entropy values of at least 32 characters. Never expose them to the browser.
OPENLC_SESSION_SECRET=
# BOT Chain network the wallet sign-in message names (968 = testnet, 677 = mainnet).
BOTCHAIN_CHAIN_ID=677
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
GEMINI_API_KEY=
# Ordered, comma-separated fallback list: tried in order until one answers.
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LEGAL_COLLECTION=payproof_malaysia_law_v1
OPENLC_DOCUMENTS_BUCKET=openlc-documents
# Use "memory" for local development, "supabase" on Render.
BACKEND_STORE=memory
PORT=8787
INVITE_BASE_URL=http://localhost:3000/orders
FRONTEND_ORIGIN=http://localhost:3000
# The deployed API runs with true.
ESCROW_VERIFIER_ENABLED=false
# See deployments/botchain-testnet.json (or botchain-mainnet.json) for the address, deploy block, and chain.
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
OPENLC_ESCROW_ADDRESS=
OPENLC_ESCROW_DEPLOY_BLOCK=
# Brevo verifies a single sender address, so it can reach any recipient without a mail domain.
# Brevo is preferred when configured, followed by SMTP and then Resend.
BREVO_API_KEY=
RESEND_API_KEY=
INVITATION_EMAIL_FROM=OpenLC <orders@your-verified-domain.example>
# Optional SMTP sender. Used only when Brevo is not configured.
# Prefer 587 with STARTTLS: TLS-scanning antivirus (Avast Mail Shield and
# similar) presents an untrusted certificate on implicit-TLS 465 and the send
# fails with "unable to verify the first certificate".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
