# Blockchain (will be replaced with BOT Chain config in tasks 5-6)
PRIVATE_KEY=

# BOT Chain
BOTCHAIN_RPC_URL=
BOTCHAIN_CHAIN_ID=
OPENLC_ESCROW_ADDRESS=
OPENLC_ESCROW_DEPLOY_BLOCK=
ESCROW_VERIFIER_ENABLED=true
ARBITRATOR_ADDRESS=
DEMO_SUPPLIER_ADDRESS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Session and Auth
OPENLC_SESSION_SECRET=

# External APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
QDRANT_URL=
QDRANT_API_KEY=

# Collections and configuration
LEGAL_COLLECTION=openlc_law_v1
BACKEND_STORE=memory
PORT=8787

# Email and invitations
INVITE_BASE_URL=http://localhost:3000/orders
FRONTEND_ORIGIN=http://localhost:3000
BREVO_API_KEY=
RESEND_API_KEY=
INVITATION_EMAIL_FROM=OpenLC <orders@your-verified-domain.example>

# Optional SMTP sender. Used only when Brevo is not configured.
# Prefer 587 with STARTTLS: TLS-scanning antivirus (Avast Mail Shield and
# similar) presents an untrusted certificate on implicit-TLS 465 and the send
# fails with "unable to verify the first certificate".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sui-era variables will be replaced by BOT Chain ones in plan tasks 5-6
