    "check-abi": "node scripts/export-abi.js --check"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.11.1"
  }
}
