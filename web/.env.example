NEXT_PUBLIC_OPENLC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_DEFAULT_ARBITRATOR_ID=00000000-0000-4000-8000-000000000001
# Dormant: openlc-api.ts's Supabase-OAuth helpers still read these, but no sign-in surface
# calls them any more (wallet sign-in is the only path). Kept so that code keeps working unchanged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# BOT Chain network: 677 = mainnet (968 = testnet). Required: when unset or unknown, every chain
# action is disabled (the UI still shows mainnet), so a build never sends BOT to the wrong network.
NEXT_PUBLIC_BOTCHAIN_CHAIN_ID=677
# OpenLCEscrow's deployed address and deploy block on that network (see deployments/*.json).
# Unset or invalid: every chain action fails closed with a visible reason instead of throwing.
NEXT_PUBLIC_OPENLC_ESCROW_ADDRESS=
NEXT_PUBLIC_OPENLC_ESCROW_DEPLOY_BLOCK=
# Arbitrator wallet written into every escrow's arbitratorWalletAddress when an order doesn't
# name its own. Must be a real address someone can sign with - an escrow funded with a fake one
# can never be settled by arbitration, so unset or invalid also fails closed (creating or funding
# an order is disabled with a visible reason until this is set).
NEXT_PUBLIC_OPENLC_ARBITRATOR_ADDRESS=

# Purchase-order extraction route (app/api/extract-po). Server side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
